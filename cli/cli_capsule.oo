// # Blackbox CLI Capsule Subcommands
//
// Logline: Dispatches pack and replay commands with crypto-agile signing, verification, and fail-closed validation.
//
// Setup: FsReadCap and FsWriteCap. Rejects path traversal and checksum/signature mismatches.
//
// Beats:
//   1. Implement cli_capsule_err helper for formatted error output.
//   2. Dispatch blackbox pack with optional --sign [algo] and --key [seed].
//   3. Dispatch blackbox replay with optional --verify integrity check.

import "record/flight_capsule.oo";
import "record/flight_replay.oo";

fn cli_capsule_err(msg: String) -> Result[Int, String] {
    print("ERR ");
    println(msg);
    return Err(msg);
}

pub fn cli_run_pack(fs: &FsReadCap, fw: &FsWriteCap, args: List[String]) -> Result[Int, String] {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    if n > 0 {
        if list_get(args, 0) == "pack" {
            i = 1;
        }
    }
    let mut out_path: String = "flight_capsule.bb";
    let mut autopsy_path: String = ".blackbox/autopsy.json";
    let mut flight_path: String = ".blackbox/flight.json";
    let mut algo: String = "sha256";
    let mut seed: String = "";
    let mut pos_count: Int = 0;

    while i < n {
        let arg: String = list_get(args, i);
        if arg == "--sign" {
            if i + 1 < n {
                let nxt: String = list_get(args, i + 1);
                if str_slice(nxt, 0, 2) != "--" {
                    algo = nxt;
                    i = i + 1;
                }
            }
        } else if arg == "--key" {
            if i + 1 < n {
                seed = list_get(args, i + 1);
                i = i + 1;
            }
        } else if str_slice(arg, 0, 2) == "--" {
            return cli_capsule_err("unknown pack flag: " + arg);
        } else {
            if pos_count == 0 && chars_len(arg) > 0 { out_path = arg; }
            if pos_count == 1 && chars_len(arg) > 0 { autopsy_path = arg; }
            if pos_count == 2 && chars_len(arg) > 0 { flight_path = arg; }
            pos_count = pos_count + 1;
        }
        i = i + 1;
    }

    let r_pack: Result[String, String] = capsule_pack_signed(fs, fw, flight_path, autopsy_path, out_path, algo, seed);
    if r_pack.is_err() {
        let e: String = match r_pack { Ok(_) => "", Err(m) => "" + m };
        return cli_capsule_err(e);
    }
    let dest: String = match r_pack { Ok(s) => s, Err(_) => "" };
    println("PACKED flight capsule: " + dest + " (algo: " + algo + ")");
    return Ok(0);
}

pub fn cli_run_replay(fs: &FsReadCap, args: List[String]) -> Result[Int, String] {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    if n > 0 {
        if list_get(args, 0) == "replay" {
            i = 1;
        }
    }
    let mut capsule_path: String = "";
    let mut verify_only: Bool = false;

    while i < n {
        let arg: String = list_get(args, i);
        if arg == "--verify" {
            verify_only = true;
        } else if str_slice(arg, 0, 2) == "--" {
            return cli_capsule_err("unknown replay flag: " + arg);
        } else {
            if chars_len(capsule_path) == 0 {
                capsule_path = arg;
            }
        }
        i = i + 1;
    }

    if chars_len(capsule_path) == 0 {
        return cli_capsule_err("missing capsule file argument for replay");
    }

    let r_rep: Result[String, String] = capsule_replay_verified(fs, capsule_path, verify_only);
    if r_rep.is_err() {
        let e: String = match r_rep { Ok(_) => "", Err(m) => "" + m };
        return cli_capsule_err(e);
    }
    let report: String = match r_rep { Ok(s) => s, Err(_) => "" };
    println(report);
    return Ok(0);
}
