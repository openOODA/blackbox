// # BB CLI Watch Sentinel Subcommand
//
// Logline: Dispatches watch command to monitor crash artifacts with polling options and fail-closed validation.
//
// Setup: ProcessCap and FsReadCap. Rejects path traversal and missing directories.
//
// Beats:
//   1. Parse watch subcommand arguments (--once, --max-ticks, --exit-on-event, --interval-sec, directory).
//   2. Dispatch headless single-pass check or stateful polling sentinel loop.
//   3. Emit formatted autopsy diagnostics and 1-turn repair recipes upon crash detection.
//   4. Enforce fail-closed error reporting and clean termination codes.

import "bridge/dir_watcher.oo";

fn cli_watch_err(msg: String) -> Result[Int, String] {
    let line: String = "ERR " + msg;
    println(line);
    return Err(msg);
}

fn cli_watch_is_digit(c: String) -> Bool {
    return c == "0" || c == "1" || c == "2" || c == "3" || c == "4" ||
           c == "5" || c == "6" || c == "7" || c == "8" || c == "9";
}

fn cli_watch_parse_int(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut val: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if !cli_watch_is_digit(c) { break; }
        let d: Int = if c == "0" { 0 } else if c == "1" { 1 } else if c == "2" { 2 }
                     else if c == "3" { 3 } else if c == "4" { 4 } else if c == "5" { 5 }
                     else if c == "6" { 6 } else if c == "7" { 7 } else if c == "8" { 8 } else { 9 };
        val = val * 10 + d;
        i = i + 1;
    }
    return val;
}

fn cli_watch_log_dir(target_dir: String) -> Int {
    print("[blackbox sentinel] Monitoring directory: ");
    println(target_dir);
    return 0;
}

fn cli_watch_log_event(ev_name: String) -> Int {
    print("[blackbox sentinel] Event: ");
    println(ev_name);
    return 0;
}

fn cli_watch_sleep(p: &ProcessCap, interval_sec: Int) -> Int {
    let s_sec: String = interval_sec.to_string();
    let _s: Result[String, String] = sys_exec(p, "sleep", s_sec);
    return 0;
}

pub fn cli_run_watch(p: &ProcessCap, fs: &FsReadCap, args: List[String]) -> Result[Int, String] {
    let n: Int = list_len(args);
    let mut offset: Int = 0;
    if n > 0 {
        if list_get(args, 0) == "watch" {
            offset = 1;
        }
    }

    let mut target_dir: String = ".";
    let mut once: Bool = false;
    let mut exit_on_event: Bool = false;
    let mut max_ticks: Int = 0;
    let mut interval_sec: Int = 1;

    let mut i: Int = offset;
    while i < n {
        let a: String = list_get(args, i);
        if a == "--once" {
            once = true;
        } else if a == "--exit-on-event" {
            exit_on_event = true;
        } else if a == "--max-ticks" {
            if i + 1 >= n {
                return cli_watch_err("missing argument for --max-ticks");
            }
            i = i + 1;
            let tick_arg: String = list_get(args, i);
            max_ticks = cli_watch_parse_int(tick_arg);
            if max_ticks <= 0 {
                return cli_watch_err("invalid max-ticks value: " + tick_arg);
            }
        } else if str_starts_with(a, "--max-ticks=") {
            let val_str: String = str_slice(a, 12, chars_len(a));
            max_ticks = cli_watch_parse_int(val_str);
            if max_ticks <= 0 {
                return cli_watch_err("invalid max-ticks value: " + val_str);
            }
        } else if a == "--interval-sec" {
            if i + 1 >= n {
                return cli_watch_err("missing argument for --interval-sec");
            }
            i = i + 1;
            interval_sec = cli_watch_parse_int(list_get(args, i));
        } else if str_starts_with(a, "--interval-sec=") {
            let int_str: String = str_slice(a, 15, chars_len(a));
            interval_sec = cli_watch_parse_int(int_str);
        } else if str_starts_with(a, "--") {
            return cli_watch_err("unknown watch flag: " + a);
        } else {
            target_dir = a;
        }
        i = i + 1;
    }

    if once {
        let r_once: Result[String, String] = dir_watcher_check_once(fs, target_dir);
        if r_once.is_err() {
            let e: String = match r_once { Ok(_) => "", Err(m) => m };
            return cli_watch_err(e);
        }
        let rep: String = match r_once { Ok(s) => s, Err(_) => "" };
        println(rep);
        return Ok(0);
    }

    let r_init: Result[DirWatchState, String] = dir_watcher_state_init(fs, target_dir);
    if r_init.is_err() {
        let e_init: String = match r_init { Ok(_) => "", Err(m) => m };
        return cli_watch_err(e_init);
    }
    let mut state: DirWatchState = match r_init { Ok(s) => s, Err(_) => return Ok(0) };
    let _ld: Int = cli_watch_log_dir(target_dir);

    if state.last_autopsy_exists && state.last_autopsy_size > 0 {
        let r_init_chk: Result[String, String] = dir_watcher_check_once(fs, target_dir);
        if r_init_chk.is_ok() {
            let rep_init: String = match r_init_chk { Ok(s) => s, Err(_) => "" };
            println("[blackbox sentinel] Existing crash artifact detected");
            println(rep_init);
            if exit_on_event {
                return Ok(0);
            }
        }
    }

    let mut ticks: Int = 0;
    while true {
        if max_ticks > 0 && ticks >= max_ticks {
            break;
        }
        let r_tick: Result[DirWatchTick, String] = dir_watcher_poll_tick(fs, state);
        if r_tick.is_err() {
            let e_tick: String = match r_tick { Ok(_) => "", Err(m) => m };
            return cli_watch_err(e_tick);
        }
        let tick: DirWatchTick = match r_tick { Ok(t) => t, Err(_) => return Ok(0) };
        state = tick.state;

        if tick.event_fired {
            let _le: Int = cli_watch_log_event(tick.event_type);
            let rep_str: String = tick.report;
            if chars_len(rep_str) > 0 {
                println(rep_str);
            }
            if exit_on_event {
                return Ok(0);
            }
        }

        ticks = ticks + 1;
        if max_ticks > 0 && ticks >= max_ticks {
            break;
        }

        if interval_sec > 0 {
            let _ls: Int = cli_watch_sleep(p, interval_sec);
        }
    }
    return Ok(0);
}
