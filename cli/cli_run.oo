// # BB CLI Dispatch
//
// Logline: Routes autopsy, diff, inspect, trace, and mcp under Ocaps. Fail closed on missing inputs.
//
// Setup: ProcessCap, FsReadCap, FsWriteCap, EnvCap, TimeCap, ThreadCap. Compiler from env.
//
// Beats:
//   1. Print usage that lists autopsy|diff|inspect|trace|mcp|heal|pack|replay|watch|run|digest|health|bench|sandbox|swarm.
//   2. Autopsy reads JSON under FsReadCap and prints a diagnosis.
//   3. Diff locates oodac, runs tokens, and exits nonzero on drift.
//   4. Trace reads flight log; mcp runs standalone stdio server.
//   5. Heal and run delegate to cli_heal and cli_run_cmd helpers.
//   6. digest/health/bench/sandbox/swarm delegate to cli_dispatch_more (Phase 6).

import "autopsy/report_formatter.oo";
import "autopsy/self_heal.oo";
import "diff/ast_diff.oo";
import "diff/compiler_runner.oo";
import "bridge/dir_watcher.oo";
import "bridge/mcp_server.oo";
import "record/flight_log.oo";
import "cli_inspect.oo";
import "cli_capsule.oo";
import "cli_watch.oo";
import "cli_heal.oo";
import "cli_run_cmd.oo";
import "cli_dispatch_more.oo";
import "cli_help.oo";

fn cli_err(msg: String) -> Result<Int, String> {
    let line: String = "ERR " + msg;
    println(line);
    return Err(msg);
}

pub fn autopsy_read_report(fs: &FsReadCap, path: String, compact: Bool) -> Result<String, String> {
    let target: String = if chars_len(path) > 0 { path } else { dir_watcher_autopsy_file() };
    let rd: Result<String, String> = dir_watcher_read_autopsy(fs, target);
    if rd.is_err() {
        let e: String = match rd { Ok(_) => "", Err(m) => m };
        return Err(e);
    }
    let json: String = match rd { Ok(s) => s, Err(_) => "" };
    if compact {
        return autopsy_format_from_json_compact(json);
    }
    return autopsy_format_from_json(json);
}

pub fn cli_run_autopsy(fs: &FsReadCap, path: String, compact: Bool) -> Result<Int, String> {
    let rep: Result<String, String> = autopsy_read_report(fs, path, compact);
    if rep.is_err() {
        let e: String = match rep { Ok(_) => "", Err(m) => m };
        return cli_err(e);
    }
    let text: String = match rep { Ok(s) => s, Err(_) => "" };
    println(text);
    return Ok(0);
}

pub fn cli_run_diff(p: &ProcessCap, fs: &FsReadCap, env: &EnvCap, file1: String, file2: String) -> Result<Int, String> {
    if chars_len(file1) == 0 {
        return cli_err("missing file argument for diff");
    }
    let loc: Result<String, String> = compiler_locate(fs, env);
    if loc.is_err() {
        let e: String = match loc { Ok(_) => "", Err(m) => m };
        return cli_err(e);
    }
    let bin: String = match loc { Ok(s) => s, Err(_) => "" };
    if chars_len(file2) > 0 {
        let cmp: Result<String, String> = ast_diff_compare_files(p, bin, file1, file2);
        if cmp.is_err() {
            let e: String = match cmp { Ok(_) => "", Err(m) => m };
            return cli_err(e);
        }
        let text: String = match cmp { Ok(s) => s, Err(_) => "" };
        println(text);
        if ast_diff_has_drift(text) {
            return cli_err("token drift detected: " + file1 + " != " + file2);
        }
        return Ok(0);
    }
    let insp: Result<String, String> = ast_diff_inspect_file(p, bin, file1);
    if insp.is_err() {
        let e: String = match insp { Ok(_) => "", Err(m) => m };
        return cli_err(e);
    }
    let text2: String = match insp { Ok(s) => s, Err(_) => "" };
    println(text2);
    return Ok(0);
}

pub fn cli_run_diff_em(p: &ProcessCap, fs: &FsReadCap, env: &EnvCap, file_path: String) -> Result<Int, String> {
    if chars_len(file_path) == 0 { return cli_err("missing file argument for diff-em"); }
    let loc: Result<String, String] = compiler_locate(fs, env);
    if loc.is_err() {
        let e: String = match loc { Ok(_) => "", Err(m) => m };
        return cli_err(e);
    }
    let bin: String = match loc { Ok(s) => s, Err(_) => "" };
    let cmp: Result<String, String> = ast_diff_em_file(p, bin, file_path);
    if cmp.is_err() {
        let e2: String = match cmp { Ok(_) => "", Err(m) => m };
        return cli_err(e2);
    }
    let text: String = match cmp { Ok(s) => s, Err(_) => "" };
    println(text);
    return Ok(0);
}

pub fn cli_run_trace(fs: &FsReadCap) -> Result<Int, String> {
    let rd: Result<String, String> = dir_watcher_read_flight(fs, "");
    if rd.is_err() {
        let e: String = match rd { Ok(_) => "", Err(m) => m };
        return cli_err(e);
    }
    let text: String = match rd { Ok(s) => s, Err(_) => "" };
    let formatted: Result<String, String> = flight_format_from_json(text);
    if formatted.is_err() {
        let e2: String = match formatted { Ok(_) => "", Err(m) => m };
        return cli_err(e2);
    }
    let output: String = match formatted { Ok(s) => s, Err(_) => "" };
    println(output);
    return Ok(0);
}

pub fn cli_run_heal(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap, env: &EnvCap, path: String) -> Result<Int, String> {
    let target: String = if chars_len(path) > 0 { path } else { dir_watcher_autopsy_file() };
    if str_index_of(target, "..") >= 0 {
        return cli_err("path traversal rejected");
    }
    if !path_exists(fs, target) {
        return cli_err("autopsy file not found: " + target);
    }
    let rd: Result<String, String> = dir_watcher_read_autopsy(fs, target);
    if rd.is_err() {
        let e: String = match rd { Ok(_) => "", Err(m) => m };
        return cli_err(e);
    }
    let json: String = match rd { Ok(s) => s, Err(_) => "" };
    let r_heal: Result<String, String> = heal_from_autopsy_json(p, fs, fw, env, json);
    if r_heal.is_err() {
        let e2: String = match r_heal { Ok(_) => "", Err(m) => m };
        return cli_err(e2);
    }
    let report: String = match r_heal { Ok(s) => s, Err(_) => "" };
    println(report);
    return Ok(0);
}

pub fn cli_dispatch(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap, env: &EnvCap, time: &TimeCap, thread: &ThreadCap, args: List[String]) -> Result<Int, String> {
    let n: Int = list_len(args);
    if n == 0 {
        println(bb_cli_help());
        return Ok(0);
    }
    let subcmd: String = list_get(args, 0);

    if subcmd == "heal" {
        return cli_run_heal_args(p, fs, fw, env, args);
    }
    if subcmd == "run" {
        return cli_run_record_cmd(p, fw, args);
    }
    if subcmd == "pack" {
        return cli_run_pack(fs, fw, args);
    }
    if subcmd == "replay" {
        return cli_run_replay(fs, args);
    }
    if subcmd == "watch" {
        return cli_run_watch(p, fs, args);
    }
    if subcmd == "autopsy" {
        let mut pth: String = "";
        let mut compact: Bool = false;
        let mut i: Int = 1;
        while i < n {
            let a: String = list_get(args, i);
            if a == "--compact" { compact = true; }
            else if chars_len(pth) == 0 { pth = a; }
            i = i + 1;
        }
        return cli_run_autopsy(fs, pth, compact);
    }
    if subcmd == "diff" {
        let f1: String = if n > 1 { list_get(args, 1) } else { "" };
        let f2: String = if n > 2 { list_get(args, 2) } else { "" };
        return cli_run_diff(p, fs, env, f1, f2);
    }
    if subcmd == "diff-em" {
        let f1: String = if n > 1 { list_get(args, 1) } else { "" };
        return cli_run_diff_em(p, fs, env, f1);
    }
    if subcmd == "inspect" {
        let st: String = if n > 1 { list_get(args, 1) } else { "" };
        let fp: String = if n > 2 { list_get(args, 2) } else { "" };
        let oa: String = if n > 3 { list_get(args, 3) } else { "" };
        return cli_run_inspect(p, fs, env, st, fp, oa);
    }
    if subcmd == "trace" {
        return cli_run_trace(fs);
    }
    if subcmd == "mcp" {
        let mut has_stdio: Bool = false;
        let mut i: Int = 1;
        while i < n {
            let a: String = list_get(args, i);
            if a == "--stdio" {
                has_stdio = true;
            } else {
                return cli_err("unknown mcp flag: " + a);
            }
            i = i + 1;
        }
        if !has_stdio {
            return cli_err("mcp subcommand requires --stdio flag");
        }
        return mcp_server_run_stdio(p, fs, fw, env);
    }
    if subcmd == "version" { println("openOODA bb v0.0.12"); return Ok(0); }
    if subcmd == "--version" { println("openOODA bb v0.0.12"); return Ok(0); }
    if subcmd == "-v" { println("openOODA bb v0.0.12"); return Ok(0); }
    if subcmd == "help" { println(bb_cli_help()); return Ok(0); }
    if subcmd == "--help" { println(bb_cli_help()); return Ok(0); }
    if subcmd == "-h" { println(bb_cli_help()); return Ok(0); }

    return cli_dispatch_more(p, fs, fw, env, time, thread, args);
}
