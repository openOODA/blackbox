// # BB Command Line Interface
//
// Logline: Entry point. Dispatches autopsy, diff, trace, and the Phase 6 verbs (digest/health/bench/sandbox/swarm) and exits fail-closed.
//
// Setup: Bound by ProcessCap, FsReadCap, FsWriteCap, EnvCap, TimeCap, ThreadCap.
//
// Beats:
//   1. Dispatch argv through cli_dispatch.
//   2. Exit 0 on Ok(0).
//   3. process_exit nonzero on Err or nonzero Ok.

import "cli_run.oo";

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap, env: &EnvCap, time: &TimeCap, thread: &ThreadCap, args: List[String]) -> Result<Int, String] {
    let r: Result[Int, String] = cli_dispatch(p, fs, fw, env, time, thread, args);
    match r {
        Ok(c) => {
            if c != 0 { process_exit(c); }
            return Ok(0);
        }
        Err(e) => {
            process_exit(1);
            return Err(e);
        }
    }
}
