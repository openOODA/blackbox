// # BB CLI — Digest
//
// Logline: Print hex digest (sha256, blake3, sha3, sha512) of a file under FsReadCap.
//
// Setup: FsReadCap reads the file. Uses std/sec/hash/{sha256,sha3,sha512,blake3}. No shell.
//
// Beats:
//   1. Parse --algo flag (sha256 default; supports blake3/sha3/sha512).
//   2. Refuse unsupported algorithm and missing/unreadable file.
//   3. Compute hash via std and print hex on success.

import "std/sec/hash/sha256.oo";
import "std/sec/hash/sha3.oo";
import "std/sec/hash/sha512.oo";
import "std/sec/hash/blake3.oo";

pub fn digest_argv_algo(args: List[String]) -> String {
    let mut algo: String = "";
    let mut i: Int = 0;
    let n: Int = list_len(args);
    while i < n {
        let a: String = list_get(args, i);
        if a == "--algo" {
            if i + 1 < n {
                algo = list_get(args, i + 1);
                i = i + 1;
            } else {
                algo = "none";
            }
        } else if chars_len(a) >= 7 && str_slice(a, 0, 7) == "--algo=" {
            algo = str_slice(a, 7, chars_len(a));
        }
        i = i + 1;
    }
    if algo == "" {
        return "sha256";
    }
    if algo == "blake3" || algo == "sha3" || algo == "sha512" || algo == "sha256" {
        return algo;
    }
    return "INVALID:" + algo;
}

pub fn digest_argv_file(args: List[String]) -> String {
    let mut path: String = "";
    let mut i: Int = 0;
    let n: Int = list_len(args);
    while i < n {
        let a: String = list_get(args, i);
        if a == "--algo" {
            i = i + 2;
        } else if chars_len(a) >= 7 && str_slice(a, 0, 7) == "--algo=" {
            i = i + 1;
        } else if chars_len(a) > 0 && str_slice(a, 0, 1) == "-" {
            i = i + 1;
        } else {
            if path == "" {
                path = a;
            }
            i = i + 1;
        }
    }
    return path;
}

pub fn compute_digest(algo: String, text: String) -> Result[String, String] {
    if algo == "sha256" {
        let h: String = sha256(text);
        return Ok(h);
    }
    if algo == "blake3" {
        let h: String = blake3(text);
        return Ok(h);
    }
    if algo == "sha3" {
        let h: String = sha3_256(text);
        return Ok(h);
    }
    if algo == "sha512" {
        let h: String = sha512(text);
        return Ok(h);
    }
    return Err("unsupported algorithm: " + algo);
}

pub fn cli_run_digest(fr: &FsReadCap, args: List[String]) -> Result[Int, String] {
    let path: String = digest_argv_file(args);
    if path == "" {
        println("usage: bb digest <file> [--algo blake3|sha3|sha512|sha256]");
        process_exit(2);
        return Err("missing file");
    }
    let algo: String = digest_argv_algo(args);
    if chars_len(algo) >= 8 && str_slice(algo, 0, 8) == "INVALID:" {
        let bad: String = str_slice(algo, 8, chars_len(algo));
        println("ERR\tdigest\tunsupported algorithm: " + bad);
        process_exit(2);
        return Err("unsupported algorithm");
    }
    if !path_exists(fr, path) {
        println("ERR\tdigest\tunreadable file: " + path);
        process_exit(2);
        return Err("unreadable file");
    }
    let tr: Result[String, String] = read_file(fr, path);
    if !tr.is_ok() {
        println("ERR\tdigest\tcannot read: " + path);
        process_exit(2);
        return Err("cannot read");
    }
    let text: String = match tr { Ok(s) => s, Err(m) => m };
    let res: Result[String, String] = compute_digest(algo, text);
    if !res.is_ok() {
        let e: String = match res { Ok(_) => "", Err(m) => m };
        println("ERR\tdigest\t" + e);
        process_exit(1);
        return Err("hash failed");
    }
    let h: String = match res { Ok(s) => s, Err(_) => "" };
    println(h);
    return Ok(0);
}
