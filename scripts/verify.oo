// # Blackbox Surface Verifier CLI
//
// Logline: Fails closed if repository invariants, MCP tool schemas, or telemetry codes drift.
//
// Setup: Pure predicate verifier. Enforces ASD-STE100 headers and line count ceiling.
//
// Beats:
//   1. Delegate to verify_surface().
//   2. Exit 0 on success.

import "verify_surface.oo";

pub fn main(&fs: FsReadCap, args: List[String]) -> Result[Int, String] {
    let res: Result[Int, String] = verify_surface();
    if res.is_err() {
        let e: String = match res { Ok(_) => "", Err(msg) => msg };
        println("ERR verification failed: " + e);
        return res;
    }
    println("verify: blackbox surface OK");
    return Ok(0);
}
