// # Blackbox Unified Test Runner
//
// Logline: Executes unified verification suite across telemetry, crash autopsy, MCP, self-healing, capsules, sentinel, and E2E.
//
// Setup: Fails closed on any test failure or invariant violation. Zero dummy assertions.
//
// Beats:
//   1. Run surface verification of tool schemas and telemetry codes.
//   2. Run crash fixture parsing and classification proofs.
//   3. Run double-run determinism invariant proofs.
//   4. Run MCP diagnostic server proofs under capability enforcement.
//   5. Run autonomous self-healing proofs (qa/heal_proof.oo).
//   6. Run portable flight capsule pack and replay proofs (qa/capsule_proof.oo).
//   7. Clean residual artifacts and run real-time crash sentinel daemon proofs (qa/watch_proof.oo).
//   8. Run Blue Ocean cross-feature E2E lifecycle proofs (qa/e2e_blue_ocean_proof.oo).
//   9. Print success status and return 0.

import "verify_surface.oo";
import "qa/crash_fixture_proof.oo";
import "qa/double_run_proof.oo";
import "qa/mcp_proof.oo";
import "qa/heal_proof.oo";
import "qa/capsule_proof.oo";
import "qa/crypto_capsule_proof.oo";
import "qa/watch_proof.oo";
import "qa/compact_proof.oo";
import "qa/em_proof.oo";
import "qa/ring_buffer_perf_proof.oo";
import "qa/e2e_blue_ocean_proof.oo";

pub fn test_run_all(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap, env: &EnvCap) -> Result[Int, String] {
    let r_surf: Result[Int, String] = verify_surface();
    if r_surf.is_err() {
        let e: String = match r_surf { Ok(_) => "", Err(msg) => msg };
        return Err("test: surface verification failed: " + e);
    }

    let r_crash: Result[Int, String] = crash_fixture_proof_run();
    if r_crash.is_err() {
        let e: String = match r_crash { Ok(_) => "", Err(msg) => msg };
        return Err("test: crash fixture proof failed: " + e);
    }

    let r_dbl: Result[Int, String] = double_run_proof_run();
    if r_dbl.is_err() {
        let e: String = match r_dbl { Ok(_) => "", Err(msg) => msg };
        return Err("test: double-run proof failed: " + e);
    }

    let r_mcp: Result[Int, String] = mcp_proof_run(p, fs, fw, env);
    if r_mcp.is_err() {
        let e: String = match r_mcp { Ok(_) => "", Err(msg) => msg };
        return Err("test: mcp proof failed: " + e);
    }

    let r_heal: Result[Int, String] = heal_proof_run(p, fs, fw, env);
    if r_heal.is_err() {
        let e: String = match r_heal { Ok(_) => "", Err(msg) => msg };
        return Err("test: heal proof failed: " + e);
    }

    let r_capsule: Result[Int, String] = capsule_proof_run(fs, fw);
    if r_capsule.is_err() {
        let e: String = match r_capsule { Ok(_) => "", Err(msg) => msg };
        return Err("test: capsule proof failed: " + e);
    }

    let r_crypto_cap: Result[Int, String] = crypto_capsule_proof_run(fs, fw);
    if r_crypto_cap.is_err() {
        let e_cc: String = match r_crypto_cap { Ok(_) => "", Err(msg) => msg };
        return Err("test: crypto capsule proof failed: " + e_cc);
    }

    let _clean_fl: Result[Void, String] = oo_fs_remove_file(fw, ".blackbox/flight.json");
    let _clean_au: Result[Void, String] = oo_fs_remove_file(fw, ".blackbox/autopsy.json");

    let r_watch: Result[Int, String] = watch_proof_run(p, fs, fw);
    if r_watch.is_err() {
        let e: String = match r_watch { Ok(_) => "", Err(msg) => msg };
        return Err("test: watch proof failed: " + e);
    }

    let r_comp: Result[Int, String] = compact_proof_run(fs);
    if r_comp.is_err() {
        let e: String = match r_comp { Ok(_) => "", Err(msg) => msg };
        return Err("test: compact proof failed: " + e);
    }

    let r_em: Result[Int, String] = em_proof_run(p, fs, env);
    if r_em.is_err() {
        let e_em: String = match r_em { Ok(_) => "", Err(msg) => msg };
        return Err("test: em proof failed: " + e_em);
    }

    let r_perf: Result[Int, String] = ring_buffer_perf_proof_run();
    if r_perf.is_err() {
        let e_perf: String = match r_perf { Ok(_) => "", Err(msg) => msg };
        return Err("test: ring buffer perf proof failed: " + e_perf);
    }

    let r_e2e: Result[Int, String] = e2e_blue_ocean_proof_run(p, fs, fw, env);
    if r_e2e.is_err() {
        let e: String = match r_e2e { Ok(_) => "", Err(msg) => msg };
        return Err("test: e2e blue ocean proof failed: " + e);
    }

    return Ok(0);
}

pub fn main(p: &ProcessCap, fs: &FsReadCap, fw: &FsWriteCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let r_w: Result[String, String] = env_get(env, "OODA_FS_WRITEDIR");
    let w_val: String = match r_w { Ok(s) => s, Err(_) => "" };
    if chars_len(w_val) == 0 {
        let bin: String = if list_len(args) > 0 { list_get(args, 0) } else { "/tmp/bb_test" };
        let r_exec: Result[String, String] = sys_exec(p, "/usr/bin/env", "OODA_COMPILER=/home/jeryd/.local/bin/oodac", "OODA_FS_READDIR=/home/jeryd", "OODA_FS_WRITEDIR=/home/jeryd/Projects/openOODA", bin, "--reexec");
        if r_exec.is_ok() {
            let out: String = match r_exec { Ok(s) => s, Err(_) => "" };
            println(out);
            return Ok(0);
        }
    }

    println("test: starting blackbox unified test suite...");
    let res: Result[Int, String] = test_run_all(p, fs, fw, env);
    if res.is_err() {
        let e: String = match res { Ok(_) => "", Err(msg) => msg };
        println("ERR test failed: " + e);
        return res;
    }
    println("test: all blackbox proofs + surface verifications passed");
    return Ok(0);
}
