// # Token Dump Diffing Engine
//
// Logline: Diffs oodac tokens dumps across two files or inspects one file.
//
// Setup: Relies on compiler_runner under ProcessCap. tokens stage only.
//
// Beats:
//   1. Split token dumps into line collections.
//   2. Compare lines across two dumps.
//   3. Format added and removed lines.
//   4. Invoke compiler_run_tokens on file targets.

import "compiler_runner.oo";
import "em_diff.oo";

pub fn ast_diff_split_lines(text: String) -> List[String] {
    let n: Int = chars_len(text);
    let mut lines: List[String] = list_new();
    let mut cur: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(text, i);
        if c == "\n" {
            lines = list_push(lines, cur);
            cur = "";
        } else {
            if c != "\r" {
                cur = cur + c;
            }
        }
        i = i + 1;
    }
    if chars_len(cur) > 0 {
        lines = list_push(lines, cur);
    }
    return lines;
}

fn ast_diff_list_contains(lines: List[String], target: String) -> Bool {
    let n: Int = list_len(lines);
    let mut i: Int = 0;
    while i < n {
        let l: String = list_get(lines, i);
        if l == target { return true; }
        i = i + 1;
    }
    return false;
}

pub fn ast_diff_compare_texts(ast_before: String, ast_after: String) -> String {
    if ast_before == ast_after {
        return "=== BLACKBOX TOKEN DIFF ===\nStatus: Identical (zero token dump drift detected)\n==================================";
    }

    let b_lines: List[String] = ast_diff_split_lines(ast_before);
    let a_lines: List[String] = ast_diff_split_lines(ast_after);

    let mut out: String = "=== BLACKBOX TOKEN DIFF ===\n";
    let mut changes: Int = 0;

    let n_b: Int = list_len(b_lines);
    let mut i: Int = 0;
    while i < n_b {
        let line: String = list_get(b_lines, i);
        if chars_len(line) > 0 {
            if !ast_diff_list_contains(a_lines, line) {
                out = out + "- " + line + "\n";
                changes = changes + 1;
            }
        }
        i = i + 1;
    }

    let n_a: Int = list_len(a_lines);
    let mut j: Int = 0;
    while j < n_a {
        let line: String = list_get(a_lines, j);
        if chars_len(line) > 0 {
            if !ast_diff_list_contains(b_lines, line) {
                out = out + "+ " + line + "\n";
                changes = changes + 1;
            }
        }
        j = j + 1;
    }

    let s_ch: String = changes.to_string();
    out = out + "Summary: " + s_ch + " token dump changes\n";
    out = out + "==================================";
    return out;
}

pub fn ast_diff_compare_files(p: &ProcessCap, bin: String, file_b: String, file_a: String) -> Result[String, String] {
    let rb: Result[String, String] = compiler_run_tokens(p, bin, file_b);
    let btxt: String = match rb { Ok(s) => s, Err(e) => return Err(e); };
    let ra: Result[String, String] = compiler_run_tokens(p, bin, file_a);
    let atxt: String = match ra { Ok(s) => s, Err(e) => return Err(e); };
    return Ok(ast_diff_compare_texts(btxt, atxt));
}

pub fn ast_diff_inspect_file(p: &ProcessCap, bin: String, file: String) -> Result[String, String] {
    let r: Result[String, String] = compiler_run_tokens(p, bin, file);
    let raw: String = match r { Ok(s) => s, Err(e) => return Err(e); };
    let mut out: String = "=== BLACKBOX TOKEN INSPECTION ===\n";
    out = out + "File: " + file + "\n\n";
    out = out + raw + "\n";
    out = out + "===============================";
    return Ok(out);
}

pub fn ast_diff_em_file(p: &ProcessCap, bin: String, file: String) -> Result[String, String] {
    return em_diff_source(p, bin, file);
}
