// # Compiler Stage Runner
//
// Logline: Locates oodac from env and runs live tokens, check, emit-c, or build.
//
// Setup: OODA_COMPILER or OODAC_BIN only. No PATH hunt. Residual stages fail closed.
//
// Beats:
//   1. Refuse empty, `..`, bare names, and shell metacharacters.
//   2. Require the compiler path to exist under FsReadCap.
//   3. Allow tokens, check, emit-c, and build. Residual names fail closed.
//   4. Capture child stdout from sys_exec.

pub fn compiler_path_ok(p: String) -> Bool {
    if chars_len(p) == 0 { return false; }
    if str_index_of(p, "..") >= 0 { return false; }
    if str_index_of(p, "/") < 0 { return false; }
    let n: Int = chars_len(p);
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(p, i);
        if c == ";" || c == "$" || c == "`" || c == "|" || c == "&" { return false; }
        if c == "(" || c == ")" { return false; }
        if c == " " || c == "\n" || c == "\r" || c == "\t" { return false; }
        i = i + 1;
    }
    return true;
}

pub fn compiler_locate_from(fs: &FsReadCap, ooda_compiler: String, oodac_bin: String) -> Result[String, String] {
    let mut p: String = ooda_compiler;
    if chars_len(p) == 0 {
        p = oodac_bin;
    }
    if chars_len(p) == 0 {
        return Err("OODA_COMPILER or OODAC_BIN required");
    }
    if !compiler_path_ok(p) {
        return Err("compiler path refused");
    }
    if !path_exists(fs, p) {
        return Err("compiler missing: " + p);
    }
    return Ok(p);
}

pub fn compiler_locate(fs: &FsReadCap, env: &EnvCap) -> Result[String, String] {
    let r1: Result[String, String] = env_get(env, "OODA_COMPILER");
    let a: String = match r1 { Ok(s) => s, Err(_) => "" };
    let r2: Result[String, String] = env_get(env, "OODAC_BIN");
    let b: String = match r2 { Ok(s) => s, Err(_) => "" };
    return compiler_locate_from(fs, a, b);
}

pub fn compiler_stage_ok(stage: String) -> Bool {
    if stage == "tokens" { return true; }
    if stage == "check" { return true; }
    if stage == "emit-c" { return true; }
    if stage == "build" { return true; }
    if stage == "em" { return true; }
    return false;
}

pub fn compiler_run_stage(p: &ProcessCap, bin: String, stage: String, file_path: String) -> Result[String, String] {
    if chars_len(file_path) == 0 {
        return Err("compiler_run_stage: empty file path");
    }
    if !compiler_stage_ok(stage) {
        return Err("residual stage: " + stage);
    }
    if chars_len(bin) == 0 {
        return Err("compiler_run_stage: empty compiler path");
    }
    if !compiler_path_ok(bin) {
        return Err("compiler_run_stage: compiler path refused");
    }
    let r: Result[String, String] = sys_exec(p, bin, stage, file_path);
    return r;
}

pub fn compiler_run_build(p: &ProcessCap, bin: String, file_path: String, out_arg: String) -> Result[String, String] {
    if chars_len(file_path) == 0 {
        return Err("compiler_run_build: empty file path");
    }
    if chars_len(bin) == 0 {
        return Err("compiler_run_build: empty compiler path");
    }
    if !compiler_path_ok(bin) {
        return Err("compiler_run_build: compiler path refused");
    }
    if chars_len(out_arg) > 0 {
        let r: Result[String, String] = sys_exec(p, bin, "build", file_path, "-o", out_arg);
        return r;
    }
    let r2: Result[String, String] = sys_exec(p, bin, "build", file_path);
    return r2;
}

pub fn compiler_run_tokens(p: &ProcessCap, bin: String, file_path: String) -> Result[String, String] {
    return compiler_run_stage(p, bin, "tokens", file_path);
}
