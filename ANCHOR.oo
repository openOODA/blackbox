// # Blackbox Subsystem — Anchor for Agents
//
// Logline: Front door for the blackbox/ directory. Autopsy reader, tokens diff, and fail-closed trace.
//
// Setup: Eight subsystem directories. Version is 0.0.3 in VERSION and blackbox_version().
//
// Beats:
//   1. record/ provides telemetry schemas and flight event records.
//   2. autopsy/ provides crash parsing, coordinate location, and root-cause classification.
//   3. diff/ provides compiler stage invocation and semantic AST diffing.
//   4. bridge/ provides ProcessCap process runners, directory watchers, and MCP bindings.
//   5. cli/ provides command line dispatch for autopsy, diff, and trace.
//   6. qa/ provides crash verification proofs, double-run determinism
//      tests, and the unified suite runner (CI builds qa/suite.oo).
//   7. docs/ provides ASD-STE100 subsystem specification.
//   8. .github/workflows/ci.yml is the build, test, and release entry
//      point (gh-owned; no scripts/ runners).

import "record/ANCHOR.oo";
import "autopsy/ANCHOR.oo";
import "diff/ANCHOR.oo";
import "bridge/ANCHOR.oo";
import "cli/ANCHOR.oo";
import "qa/ANCHOR.oo";
import "docs/ANCHOR.oo";

pub fn blackbox_version() -> String {
    return "0.0.3";
}
