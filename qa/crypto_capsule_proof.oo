// # Crypto Agile Capsule Proof Suite
//
// Logline: Validates self-describing crypto-agile flight capsules across CRC32, SHA-256, BLAKE3, SHA-3, SHA-512, and Ed25519.
//
// Setup: FsReadCap and FsWriteCap. Proves signing, verification, tampering fail-closed, and double-run determinism.
//
// Beats:
//   1. Assert CRC32, SHA-256, BLAKE3, SHA-3, SHA-512, and Ed25519 roundtrip pack, unpack, and verify.
//   2. Assert tampered payload is detected and rejected fail-closed with (verified: FAILED) for all algorithms.
//   3. Assert replay --verify reports successful cryptographic validation.
//   4. Assert double-run determinism: Run_1 == Run_2.

import "record/flight_capsule.oo";
import "record/flight_replay.oo";
import "record/crypto_agile.oo";
import "cli/cli_capsule.oo";

fn crypto_test_autopsy() -> String {
    let mut j: String = "{\n  \"schema_version\": \"1.0.0\",\n  \"crash_signal\": 11,\n  \"signal_name\": \"SIGSEGV\",\n";
    j = j + "  \"fault_address\": \"0x0\",\n  \"failure_coordinate\": \"core/agent.oo:88:4:dispatch\",\n";
    j = j + "  \"root_cause\": \"NULL_POINTER_DEREFERENCE\",\n  \"description\": \"crypto probe null fault\",\n";
    j = j + "  \"rip\": \"0x55555556d300\",\n  \"rsp\": \"0x7fffffffe180\",\n  \"rbp\": \"0x7fffffffe1b0\",\n";
    j = j + "  \"cap_trapped\": false,\n  \"cap_mask_held\": 7,\n  \"remediation\": \"Check null\"\n}";
    return j;
}

fn crypto_test_flight() -> String {
    return "{\"schema_version\":\"1.0.0\",\"capacity\":1,\"total_events\":1,\"events\":[{\"seq\":0,\"phase\":1,\"type\":2,\"detail\":\"probe\",\"timestamp\":1000}]}";
}

fn proof_crypto_roundtrip(fs: &FsReadCap, fw: &FsWriteCap, algo: String, out_bb: String) -> Result[Int, String] {
    let a_path: String = "blackbox/qa/tmp_crypto_auto.json";
    let f_path: String = "blackbox/qa/tmp_crypto_flight.json";
    let w1: Result[Void, String] = write_file(fw, a_path, crypto_test_autopsy());
    if w1.is_err() { return Err("write autopsy failed"); }
    let w2: Result[Void, String] = write_file(fw, f_path, crypto_test_flight());
    if w2.is_err() { return Err("write flight failed"); }

    let p_res: Result[String, String] = capsule_pack_signed(fs, fw, f_path, a_path, out_bb, algo, "");
    if p_res.is_err() {
        let e: String = match p_res { Ok(_) => "", Err(m) => m };
        return Err("pack failed for " + algo + ": " + e);
    }

    let u_res: Result[CapsuleData, String] = capsule_unpack(fs, out_bb);
    if u_res.is_err() {
        let e2: String = match u_res { Ok(_) => "", Err(m) => m };
        return Err("unpack failed for " + algo + ": " + e2);
    }
    let data: CapsuleData = match u_res { Ok(d) => d, Err(_) => return Err("unreachable") };
    let norm_algo: String = crypto_agile_normalize_algo(algo);
    if data.algo != norm_algo {
        return Err("algo mismatch: expected " + norm_algo + ", got " + data.algo);
    }
    if chars_len(data.digest) == 0 {
        return Err("digest missing for algo " + algo);
    }
    if norm_algo == "ed25519" {
        let exp_pk: String = sovereign_default_pubkey();
        if data.signer != exp_pk {
            return Err("signer mismatch: expected " + exp_pk + ", got " + data.signer);
        }
    }

    let rep_res: Result[String, String] = capsule_replay_verified(fs, out_bb, true);
    if rep_res.is_err() {
        let e3: String = match rep_res { Ok(_) => "", Err(m) => m };
        return Err("replay --verify failed for " + algo + ": " + e3);
    }

    return Ok(0);
}

fn proof_crypto_tamper(fs: &FsReadCap, fw: &FsWriteCap, bb_path: String) -> Result[Int, String] {
    let rd: Result[String, String] = read_file(fs, bb_path);
    if rd.is_err() { return Err("read for tamper failed"); }
    let orig: String = match rd { Ok(s) => s, Err(_) => "" };
    let target_str: String = "0x55555556d300";
    let idx: Int = str_index_of(orig, target_str);
    if idx < 0 { return Err("target string for tamper not found"); }
    let tampered: String = str_slice(orig, 0, idx) + "0x55555556d301" + str_slice(orig, idx + 14, chars_len(orig));
    let w_t: Result[Void, String] = write_file(fw, bb_path + ".tampered", tampered);
    if w_t.is_err() { return Err("write tampered failed"); }

    let r_bad: Result[CapsuleData, String] = capsule_unpack(fs, bb_path + ".tampered");
    if r_bad.is_ok() {
        return Err("FAIL tamper proof: modified capsule passed verification unexpectedly");
    }
    let err_msg: String = match r_bad { Ok(_) => "", Err(m) => m };
    if str_index_of(err_msg, "(verified: FAILED)") < 0 {
        return Err("FAIL tamper proof: expected '(verified: FAILED)' in error message, got: " + err_msg);
    }
    return Ok(0);
}

fn proof_has_null(s: String) -> Bool {
    let n: Int = bytes_len(s);
    let mut i: Int = 0;
    while i < n {
        if byte_at(s, i) == 0 { return true; }
        i = i + 1;
    }
    return false;
}

fn proof_crypto_tamper_ed25519(fs: &FsReadCap, fw: &FsWriteCap, bb_path: String) -> Result[Int, String] {
    let rd: Result[String, String] = read_file(fs, bb_path);
    if rd.is_err() { return Err("read ed25519 capsule for tamper failed"); }
    let orig: String = match rd { Ok(s) => s, Err(_) => "" };
    let u_orig: Result[CapsuleData, String] = capsule_unpack(fs, bb_path);
    if u_orig.is_err() { return Err("unpack original ed25519 failed"); }
    let orig_data: CapsuleData = match u_orig { Ok(d) => d, Err(_) => return Err("unreachable") };
    let orig_dig: String = orig_data.digest;
    let orig_signer: String = orig_data.signer;

    let s_bad: String = str_slice(orig_dig, 0, 64) + "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff";
    let idx_d: Int = str_index_of(orig, orig_dig);
    if idx_d < 0 { return Err("ed25519 digest not found in capsule"); }
    let bb_bad_s: String = str_slice(orig, 0, idx_d) + s_bad + str_slice(orig, idx_d + chars_len(orig_dig), chars_len(orig));
    let _w1: Result[Void, String] = write_file(fw, bb_path + ".bad_s", bb_bad_s);
    let r_bad_s: Result[CapsuleData, String] = capsule_unpack(fs, bb_path + ".bad_s");
    if r_bad_s.is_ok() { return Err("FAIL: S out of group order passed unexpectedly"); }
    let err_s: String = match r_bad_s { Ok(_) => "", Err(m) => m };
    if proof_has_null(err_s) { return Err("FAIL: null byte in S error"); }
    if str_index_of(err_s, "(verified: FAILED)") < 0 {
        return Err("FAIL: S out of group order missing '(verified: FAILED)': " + err_s);
    }
    let rep_bad_s: Result[String, String] = capsule_replay_verified(fs, bb_path + ".bad_s", true);
    if rep_bad_s.is_ok() { return Err("FAIL: replay verify passed bad S"); }
    let err_rep_s: String = match rep_bad_s { Ok(_) => "", Err(m) => m };
    if proof_has_null(err_rep_s) { return Err("FAIL: null byte in replay bad S error"); }
    if str_index_of(err_rep_s, "(verified: FAILED)") < 0 {
        return Err("FAIL: replay bad S missing '(verified: FAILED)': " + err_rep_s);
    }

    let d_trunc: String = str_slice(orig_dig, 0, 127);
    let bb_trunc: String = str_slice(orig, 0, idx_d) + d_trunc + str_slice(orig, idx_d + chars_len(orig_dig), chars_len(orig));
    let _w2: Result[Void, String] = write_file(fw, bb_path + ".trunc", bb_trunc);
    let r_trunc: Result[CapsuleData, String] = capsule_unpack(fs, bb_path + ".trunc");
    if r_trunc.is_ok() { return Err("FAIL: truncated digest passed unexpectedly"); }
    let err_tr: String = match r_trunc { Ok(_) => "", Err(m) => m };
    if proof_has_null(err_tr) { return Err("FAIL: null byte in truncated digest error"); }
    if str_index_of(err_tr, "(verified: FAILED)") < 0 {
        return Err("FAIL: truncated digest missing '(verified: FAILED)': " + err_tr);
    }

    let bad_signer: String = "3" + str_slice(orig_signer, 1, chars_len(orig_signer));
    let idx_s: Int = str_index_of(orig, orig_signer);
    if idx_s >= 0 {
        let bb_bad_pk: String = str_slice(orig, 0, idx_s) + bad_signer + str_slice(orig, idx_s + chars_len(orig_signer), chars_len(orig));
        let _w3: Result[Void, String] = write_file(fw, bb_path + ".bad_pk", bb_bad_pk);
        let r_bad_pk: Result[CapsuleData, String] = capsule_unpack(fs, bb_path + ".bad_pk");
        if r_bad_pk.is_ok() { return Err("FAIL: tampered signer key passed unexpectedly"); }
        let err_pk: String = match r_bad_pk { Ok(_) => "", Err(m) => m };
        if proof_has_null(err_pk) { return Err("FAIL: null byte in tampered signer error"); }
        if str_index_of(err_pk, "(verified: FAILED)") < 0 {
            return Err("FAIL: tampered signer key missing '(verified: FAILED)': " + err_pk);
        }
    }

    let _cl_s: Result[Void, String] = oo_fs_remove_file(fw, bb_path + ".bad_s");
    let _cl_tr: Result[Void, String] = oo_fs_remove_file(fw, bb_path + ".trunc");
    let _cl_pk: Result[Void, String] = oo_fs_remove_file(fw, bb_path + ".bad_pk");
    return Ok(0);
}

pub fn crypto_capsule_proof_run(fs: &FsReadCap, fw: &FsWriteCap) -> Result[Int, String] {
    let r_crc: Result[Int, String] = proof_crypto_roundtrip(fs, fw, "crc32", "blackbox/qa/tmp_test_crc.bb");
    if r_crc.is_err() { return r_crc; }

    let r_sha: Result[Int, String] = proof_crypto_roundtrip(fs, fw, "sha256", "blackbox/qa/tmp_test_sha.bb");
    if r_sha.is_err() { return r_sha; }

    let r_b3: Result[Int, String] = proof_crypto_roundtrip(fs, fw, "blake3", "blackbox/qa/tmp_test_b3.bb");
    if r_b3.is_err() { return r_b3; }

    let r_sha3: Result[Int, String] = proof_crypto_roundtrip(fs, fw, "sha3", "blackbox/qa/tmp_test_sha3.bb");
    if r_sha3.is_err() { return r_sha3; }

    let r_sha512: Result[Int, String] = proof_crypto_roundtrip(fs, fw, "sha512", "blackbox/qa/tmp_test_sha512.bb");
    if r_sha512.is_err() { return r_sha512; }

    let r_ed: Result[Int, String] = proof_crypto_roundtrip(fs, fw, "ed25519", "blackbox/qa/tmp_test_ed.bb");
    if r_ed.is_err() { return r_ed; }

    let t_crc: Result[Int, String] = proof_crypto_tamper(fs, fw, "blackbox/qa/tmp_test_crc.bb");
    if t_crc.is_err() { return t_crc; }

    let t_sha: Result[Int, String] = proof_crypto_tamper(fs, fw, "blackbox/qa/tmp_test_sha.bb");
    if t_sha.is_err() { return t_sha; }

    let t_b3: Result[Int, String] = proof_crypto_tamper(fs, fw, "blackbox/qa/tmp_test_b3.bb");
    if t_b3.is_err() { return t_b3; }

    let t_sha3: Result[Int, String] = proof_crypto_tamper(fs, fw, "blackbox/qa/tmp_test_sha3.bb");
    if t_sha3.is_err() { return t_sha3; }

    let t_sha512: Result[Int, String] = proof_crypto_tamper(fs, fw, "blackbox/qa/tmp_test_sha512.bb");
    if t_sha512.is_err() { return t_sha512; }

    let t_ed: Result[Int, String] = proof_crypto_tamper(fs, fw, "blackbox/qa/tmp_test_ed.bb");
    if t_ed.is_err() { return t_ed; }

    let t_ed_hostile: Result[Int, String] = proof_crypto_tamper_ed25519(fs, fw, "blackbox/qa/tmp_test_ed.bb");
    if t_ed_hostile.is_err() { return t_ed_hostile; }

    // Double-run determinism proof: Run_1 == Run_2
    let d1: Result[String, String] = capsule_pack_signed(fs, fw, "blackbox/qa/tmp_crypto_flight.json", "blackbox/qa/tmp_crypto_auto.json", "blackbox/qa/tmp_det1.bb", "sha256", "");
    let d2: Result[String, String] = capsule_pack_signed(fs, fw, "blackbox/qa/tmp_crypto_flight.json", "blackbox/qa/tmp_crypto_auto.json", "blackbox/qa/tmp_det2.bb", "sha256", "");
    if d1.is_err() || d2.is_err() { return Err("determinism pack failed"); }
    let s1: String = match read_file(fs, "blackbox/qa/tmp_det1.bb") { Ok(s) => s, Err(_) => "" };
    let s2: String = match read_file(fs, "blackbox/qa/tmp_det2.bb") { Ok(s) => s, Err(_) => "" };
    if s1 != s2 {
        return Err("FAIL double-run determinism: Run_1 != Run_2");
    }

    let _cl1: Result[Void, String] = oo_fs_remove_file(fw, "blackbox/qa/tmp_crypto_auto.json");
    let _cl2: Result[Void, String] = oo_fs_remove_file(fw, "blackbox/qa/tmp_crypto_flight.json");
    let _cl3: Result[Void, String] = oo_fs_remove_file(fw, "blackbox/qa/tmp_test_crc.bb");
    let _cl4: Result[Void, String] = oo_fs_remove_file(fw, "blackbox/qa/tmp_test_sha.bb");
    let _cl5: Result[Void, String] = oo_fs_remove_file(fw, "blackbox/qa/tmp_test_b3.bb");
    let _cl6: Result[Void, String] = oo_fs_remove_file(fw, "blackbox/qa/tmp_test_sha3.bb");
    let _cl7: Result[Void, String] = oo_fs_remove_file(fw, "blackbox/qa/tmp_test_sha512.bb");
    let _cl8: Result[Void, String] = oo_fs_remove_file(fw, "blackbox/qa/tmp_test_ed.bb");
    let _cl9: Result[Void, String] = oo_fs_remove_file(fw, "blackbox/qa/tmp_test_crc.bb.tampered");
    let _cl10: Result[Void, String] = oo_fs_remove_file(fw, "blackbox/qa/tmp_test_sha.bb.tampered");
    let _cl11: Result[Void, String] = oo_fs_remove_file(fw, "blackbox/qa/tmp_test_b3.bb.tampered");
    let _cl12: Result[Void, String] = oo_fs_remove_file(fw, "blackbox/qa/tmp_test_sha3.bb.tampered");
    let _cl13: Result[Void, String] = oo_fs_remove_file(fw, "blackbox/qa/tmp_test_sha512.bb.tampered");
    let _cl14: Result[Void, String] = oo_fs_remove_file(fw, "blackbox/qa/tmp_test_ed.bb.tampered");
    let _cl15: Result[Void, String] = oo_fs_remove_file(fw, "blackbox/qa/tmp_det1.bb");
    let _cl16: Result[Void, String] = oo_fs_remove_file(fw, "blackbox/qa/tmp_det2.bb");

    return Ok(0);
}
