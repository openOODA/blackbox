pub fn proof_verify_sigill() -> Result[Int, String] {
    let json: String = crash_fixture_sigill_json();
    let res: Result[AutopsyData, String] = autopsy_parse(json);
    let data: AutopsyData = match res { Ok(d) => d, Err(e) => return Err("proof_verify_sigill: parse failed: " + e); };
    if data.crash_signal != 4 { return Err("proof_verify_sigill: expected signal 4"); }
    if data.signal_name != "SIGILL" { return Err("proof_verify_sigill: expected SIGILL"); }
    if data.root_cause != "ILLEGAL_INSTRUCTION" { return Err("proof_verify_sigill: expected ILLEGAL_INSTRUCTION"); }
    if data.registers_rip != "0x000055555556f890" { return Err("proof_verify_sigill: registers_rip mismatch"); }
    if data.registers_rsp != "0x00007fffffffe100" { return Err("proof_verify_sigill: registers_rsp mismatch"); }
    if data.registers_rbp != "0x00007fffffffe130" { return Err("proof_verify_sigill: registers_rbp mismatch"); }

    let coord: FailureCoordinate = coordinate_parse(data.failure_coordinate);
    if coordinate_format_source(coord) != "core/cpu/dispatch.oo:31:4" { return Err("proof_verify_sigill: source coord mismatch"); }
    if str_index_of(data.remediation, "core/cpu/dispatch.oo:31:4") < 0 { return Err("proof_verify_sigill: missing coord in remed"); }
    if str_index_of(data.remediation, "CPU feature guard") < 0 { return Err("proof_verify_sigill: missing patch hint"); }
    return Ok(0);
}

pub fn proof_verify_assertion() -> Result[Int, String] {
    let json: String = crash_fixture_sigabrt_json();
    let res: Result[AutopsyData, String] = autopsy_parse(json);
    let data: AutopsyData = match res { Ok(d) => d, Err(e) => return Err("proof_verify_assertion: parse failed: " + e); };
    if data.crash_signal != 6 { return Err("proof_verify_assertion: expected signal 6"); }
    if data.signal_name != "SIGABRT" { return Err("proof_verify_assertion: expected SIGABRT"); }
    if data.root_cause != "ABORT_TRIGGERED" { return Err("proof_verify_assertion: expected ABORT_TRIGGERED"); }
    if data.registers_rip != "0x000055555556d010" { return Err("proof_verify_assertion: registers_rip mismatch"); }
    if data.registers_rsp != "0x00007fffffffe090" { return Err("proof_verify_assertion: registers_rsp mismatch"); }
    if data.registers_rbp != "0x00007fffffffe0c0" { return Err("proof_verify_assertion: registers_rbp mismatch"); }

    let coord: FailureCoordinate = coordinate_parse(data.failure_coordinate);
    if coordinate_format_source(coord) != "core/contract/assert.oo:15:3" { return Err("proof_verify_assertion: source coord mismatch"); }
    if str_index_of(data.remediation, "core/contract/assert.oo:15:3") < 0 { return Err("proof_verify_assertion: missing coord in remed"); }
    return Ok(0);
}

pub fn crash_fixture_proof_run() -> Result[Int, String] {
    let r1: Result[Int, String] = proof_verify_null_deref();
    if r1.is_err() { return r1; }

    let r2: Result[Int, String] = proof_verify_cap_trap();
    if r2.is_err() { return r2; }

    let r3: Result[Int, String] = proof_verify_arena_oom();
    if r3.is_err() { return r3; }

    let r4: Result[Int, String] = proof_verify_sigbus();
    if r4.is_err() { return r4; }

    let r5: Result[Int, String] = proof_verify_sigill();
    if r5.is_err() { return r5; }

    let r6: Result[Int, String] = proof_verify_assertion();
    if r6.is_err() { return r6; }

    return Ok(0);
}
