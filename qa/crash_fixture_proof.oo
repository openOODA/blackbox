    let coord: FailureCoordinate = coordinate_parse(data.failure_coordinate);
    if coordinate_format_source(coord) != "core/mem/buffer.oo:64:8" { return Err("proof_verify_sigbus: source coord mismatch"); }
    if str_index_of(data.remediation, "core/mem/buffer.oo:64:8") < 0 { return Err("proof_verify_sigbus: missing coord in remed"); }
    if str_index_of(data.remediation, "alignment guard") < 0 { return Err("proof_verify_sigbus: missing patch hint"); }
    return Ok(0);
