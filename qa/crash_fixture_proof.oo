    let json: String = crash_fixture_sigbus_json();
    let res: Result[AutopsyData, String] = autopsy_parse(json);
    let data: AutopsyData = match res { Ok(d) => d, Err(e) => return Err("proof_verify_sigbus: parse failed: " + e); };
    if data.crash_signal != 7 { return Err("proof_verify_sigbus: expected signal 7"); }
    if data.signal_name != "SIGBUS" { return Err("proof_verify_sigbus: expected SIGBUS"); }
    if data.root_cause != "BUS_ERROR" { return Err("proof_verify_sigbus: expected BUS_ERROR"); }
    if data.registers_rip != "0x000055555556e420" { return Err("proof_verify_sigbus: registers_rip mismatch"); }
    if data.registers_rsp != "0x00007fffffffe150" { return Err("proof_verify_sigbus: registers_rsp mismatch"); }
