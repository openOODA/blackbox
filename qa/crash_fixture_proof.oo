// # Crash Fixture Verification Proof
//
// Logline: Proves that crash payloads parse accurately and produce correct root-cause classifications.
//
// Setup: Pure string fixtures. Proves POSIX signals, capability traps, and arena OOM fail closed.
//
// Beats:
//   1. Verify SIGSEGV null pointer dereference parsing and coordinate extraction.
//   2. Verify capability trap interception and bitmask extraction.
//   3. Verify arena memory exhaustion detection and patch guards.
//   4. Verify SIGBUS and SIGILL fault classification and exact file:line:col coordinates.
//   5. Verify contract assertion abort diagnostics and 1-turn remediation.
//   6. Run full verification suite across all crash fixtures.

import "autopsy/autopsy_parser.oo";
import "autopsy/coordinate_locator.oo";
import "autopsy/root_cause.oo";
import "autopsy/report_formatter.oo";
import "crash_fixtures.oo";

type AutopsyStackFrame = struct {
    frame_num: Int,
    address: String,
    symbol: String,
    location: String
};

type AutopsyData = struct {
    schema_version: String,
    crash_signal: Int,
    signal_name: String,
    fault_address: String,
    failure_coordinate: String,
    root_cause: String,
    description: String,
    backtrace: List[AutopsyStackFrame],
    registers_rip: String,
    registers_rsp: String,
    registers_rbp: String,
    cap_trapped: Bool,
    cap_mask_required: Int,
    cap_mask_held: Int,
    granted_caps: List[String],
    remediation: String
};

pub fn proof_verify_null_deref() -> Result[Int, String] {
    let json: String = crash_fixture_null_ptr_json();
    let res: Result[AutopsyData, String] = autopsy_parse(json);
    let data: AutopsyData = match res { Ok(d) => d, Err(e) => return Err("proof_verify_null_deref: parse failed: " + e); };
    if data.crash_signal != 11 { return Err("proof_verify_null_deref: expected signal 11"); }
    if data.signal_name != "SIGSEGV" { return Err("proof_verify_null_deref: expected SIGSEGV"); }
    if data.root_cause != "NULL_POINTER_DEREFERENCE" { return Err("proof_verify_null_deref: expected NULL_POINTER_DEREFERENCE"); }
    if data.registers_rip != "0x000055555556a1b0" { return Err("proof_verify_null_deref: registers_rip mismatch"); }
    if data.registers_rsp != "0x00007fffffffe210" { return Err("proof_verify_null_deref: registers_rsp mismatch"); }
    if data.registers_rbp != "0x00007fffffffe240" { return Err("proof_verify_null_deref: registers_rbp mismatch"); }

    let coord: FailureCoordinate = coordinate_parse(data.failure_coordinate);
    if !coordinate_is_valid(coord) { return Err("proof_verify_null_deref: invalid failure coordinate"); }
    if coord.file_path != "core/alloc/arena.oo" { return Err("proof_verify_null_deref: coordinate file mismatch"); }
    if coord.line_num != 42 { return Err("proof_verify_null_deref: coordinate line mismatch"); }
    let s_src: String = coordinate_format_source(coord);
    if s_src != "core/alloc/arena.oo:42:5" { return Err("proof_verify_null_deref: source coordinate mismatch: " + s_src); }

    let report: String = autopsy_format_report(data);
    if str_index_of(report, "BLACKBOX CRASH AUTOPSY") < 0 { return Err("proof_verify_null_deref: missing banner"); }
    if str_index_of(report, "NULL_POINTER_DEREFERENCE") < 0 { return Err("proof_verify_null_deref: missing root cause"); }
    if str_index_of(data.remediation, "core/alloc/arena.oo:42:5") < 0 { return Err("proof_verify_null_deref: missing coord in remed"); }
    return Ok(0);
}

pub fn proof_verify_cap_trap() -> Result[Int, String] {
    let json: String = crash_fixture_cap_trap_json();
    let res: Result[AutopsyData, String] = autopsy_parse(json);
    let data: AutopsyData = match res { Ok(d) => d, Err(e) => return Err("proof_verify_cap_trap: parse failed: " + e); };
    if !data.cap_trapped { return Err("proof_verify_cap_trap: expected cap_trapped true"); }
    if data.cap_mask_required != 5 { return Err("proof_verify_cap_trap: expected required mask 5"); }
    if data.cap_mask_held != 1 { return Err("proof_verify_cap_trap: expected held mask 1"); }
    if data.root_cause != "CAPABILITY_TRAP_VIOLATION" { return Err("proof_verify_cap_trap: expected CAPABILITY_TRAP_VIOLATION"); }
    if data.registers_rip != "0x000055555556d300" { return Err("proof_verify_cap_trap: registers_rip mismatch"); }
    if data.registers_rsp != "0x00007fffffffe180" { return Err("proof_verify_cap_trap: registers_rsp mismatch"); }
    if data.registers_rbp != "0x00007fffffffe1b0" { return Err("proof_verify_cap_trap: registers_rbp mismatch"); }

    let coord: FailureCoordinate = coordinate_parse(data.failure_coordinate);
    if coordinate_format_source(coord) != "sec/cap/cap_require.oo:18:2" { return Err("proof_verify_cap_trap: source coord mismatch"); }
    if str_index_of(data.remediation, "sec/cap/cap_require.oo:18:2") < 0 { return Err("proof_verify_cap_trap: missing coord in remed"); }
    return Ok(0);
}

pub fn proof_verify_arena_oom() -> Result[Int, String] {
    let json: String = crash_fixture_arena_oom_json();
    let res: Result[AutopsyData, String] = autopsy_parse(json);
    let data: AutopsyData = match res { Ok(d) => d, Err(e) => return Err("proof_verify_arena_oom: parse failed: " + e); };
    if data.crash_signal != 6 { return Err("proof_verify_arena_oom: expected signal 6"); }
    if data.root_cause != "ARENA_MEMORY_EXHAUSTION" { return Err("proof_verify_arena_oom: expected ARENA_MEMORY_EXHAUSTION"); }
    if data.registers_rip != "0x000055555556b100" { return Err("proof_verify_arena_oom: registers_rip mismatch"); }
    if data.registers_rsp != "0x00007fffffffe190" { return Err("proof_verify_arena_oom: registers_rsp mismatch"); }
    if data.registers_rbp != "0x00007fffffffe1c0" { return Err("proof_verify_arena_oom: registers_rbp mismatch"); }

    let coord: FailureCoordinate = coordinate_parse(data.failure_coordinate);
    if coordinate_format_source(coord) != "core/alloc/arena.oo:88:12" { return Err("proof_verify_arena_oom: source coord mismatch"); }
    if str_index_of(data.remediation, "core/alloc/arena.oo:88:12") < 0 { return Err("proof_verify_arena_oom: missing coord in remed"); }
    if str_index_of(data.remediation, "arena capacity guard") < 0 { return Err("proof_verify_arena_oom: missing patch hint"); }
    return Ok(0);
}

