// # Model Context Protocol Bridge
//
// Logline: Exposes blackbox autopsy and compiler inspect as MCP tool endpoints.
//
// Setup: Declares tool count, capability bitmasks, and dispatch. Compiler from env only.
//
// Beats:
//   1. Expose MCP tool catalog entries for blackbox_autopsy and blackbox_diff.
//   2. Define required capability bitmasks (FsReadCap mask 1, ProcessCap mask 5).
//   3. Dispatch tools/call to autopsy formatter or tokens inspect.
//   4. Fail closed on missing compiler. No Result unwrap.

import "autopsy/report_formatter.oo";
import "diff/ast_diff.oo";
import "diff/compiler_runner.oo";
import "dir_watcher.oo";

pub fn blackbox_mcp_tool_count() -> Int {
    return 2;
}

pub fn blackbox_mcp_tool_caps(name: String) -> Int {
    if name == "blackbox_autopsy" {
        return 1;
    }
    if name == "blackbox_diff" {
        return 5;
    }
    return 0 - 1;
}

pub fn blackbox_mcp_tool_list_json() -> String {
    let mut out: String = "[";
    out = out + "{\"name\":\"blackbox_autopsy\",";
    out = out + "\"description\":\"Parse autopsy JSON and output 1-turn root-cause diagnosis\",";
    out = out + "\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Path to autopsy.json\"}},\"required\":[]}},";
    out = out + "{\"name\":\"blackbox_diff\",";
    out = out + "\"description\":\"Run oodac tokens on a source file and display the dump\",";
    out = out + "\"inputSchema\":{\"type\":\"object\",\"properties\":{\"file\":{\"type\":\"string\",\"description\":\"Path to .oo file\"}},\"required\":[\"file\"]}}";
    out = out + "]";
    return out;
}

fn mcp_extract_arg(args: String, key: String) -> String {
    let pat: String = "\"" + key + "\"";
    let n: Int = chars_len(args);
    let plen: Int = chars_len(pat);
    let mut i: Int = 0;
    while i < n {
        let end_p: Int = i + plen;
        if end_p <= n {
            if str_slice(args, i, end_p) == pat {
                let mut j: Int = end_p;
                while j < n {
                    if char_at(args, j) == ":" {
                        let mut k: Int = j + 1;
                        while k < n {
                            let c: String = char_at(args, k);
                            if c == "\"" {
                                let mut m: Int = k + 1;
                                while m < n {
                                    if char_at(args, m) == "\"" {
                                        return str_slice(args, k + 1, m);
                                    }
                                    m = m + 1;
                                }
                                return "";
                            }
                            if c != " " { if c != "\t" { break; } }
                            k = k + 1;
                        }
                    }
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
    return "";
}

pub fn blackbox_mcp_escape(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\\" { out = out + "\\\\"; }
        else if c == "\"" { out = out + "\\\""; }
        else if c == "\n" { out = out + "\\n"; }
        else if c == "\r" { out = out + "\\r"; }
        else if c == "\t" { out = out + "\\t"; }
        else { out = out + c; }
        i = i + 1;
    }
    return out;
}

pub fn blackbox_mcp_wrap_text(text: String) -> String {
    let esc: String = blackbox_mcp_escape(text);
    return "{\"content\":[{\"type\":\"text\",\"text\":\"" + esc + "\"}]}";
}

fn mcp_err(msg: String) -> String {
    let esc: String = blackbox_mcp_escape(msg);
    return "{\"isError\":true,\"content\":[{\"type\":\"text\",\"text\":\"" + esc + "\"}]}";
}

pub fn blackbox_mcp_dispatch(name: String, args: String, fs: &FsReadCap, p: &ProcessCap, env: &EnvCap) -> String {
    if name == "blackbox_autopsy" {
        let mut pth: String = mcp_extract_arg(args, "path");
        if chars_len(pth) == 0 {
            pth = dir_watcher_autopsy_file();
        }
        let rd: Result[String, String] = dir_watcher_read_autopsy(fs, pth);
        if rd.is_err() {
            let e: String = match rd { Ok(_) => "", Err(m) => m };
            return mcp_err("Failed to read autopsy file: " + e);
        }
        let json: String = match rd { Ok(s) => s, Err(_) => "" };
        let rep: Result[String, String] = autopsy_format_from_json(json);
        if rep.is_err() {
            let e2: String = match rep { Ok(_) => "", Err(m) => m };
            return mcp_err("Failed to parse autopsy: " + e2);
        }
        let text: String = match rep { Ok(s) => s, Err(_) => "" };
        return blackbox_mcp_wrap_text(text);
    }

    if name == "blackbox_diff" {
        let fl: String = mcp_extract_arg(args, "file");
        if chars_len(fl) == 0 {
            return mcp_err("Missing required argument 'file'");
        }
        let loc: Result[String, String] = compiler_locate(fs, env);
        if loc.is_err() {
            let e: String = match loc { Ok(_) => "", Err(m) => m };
            return mcp_err(e);
        }
        let bin: String = match loc { Ok(s) => s, Err(_) => "" };
        let dr: Result[String, String] = ast_diff_inspect_file(p, bin, fl);
        if dr.is_err() {
            let e3: String = match dr { Ok(_) => "", Err(m) => m };
            return mcp_err(e3);
        }
        let dump: String = match dr { Ok(s) => s, Err(_) => "" };
        return blackbox_mcp_wrap_text(dump);
    }

    return mcp_err("Unknown tool: " + name);
}

pub fn mcp_bridge_tool_count() -> Int {
    return blackbox_mcp_tool_count();
}

pub fn mcp_bridge_tool_caps(name: String) -> Int {
    return blackbox_mcp_tool_caps(name);
}
