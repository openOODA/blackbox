// # Model Context Protocol Bridge
//
// Logline: Exposes blackbox autopsy and compiler AST diff capabilities as MCP tool endpoints.
//
// Setup: Declares tool count, capability bitmasks, and tool schemas for openOODA/mcp integration.
//
// Beats:
//   1. Expose MCP tool catalog entries for blackbox_autopsy and blackbox_diff.
//   2. Define required capability bitmasks (FsReadCap mask 1, ProcessCap mask 5).
//   3. Dispatch tools/call requests to autopsy formatter or AST diff engine.
//   4. Format JSON response envelopes for agent tool execution.

import "autopsy/report_formatter.oo";
import "diff/ast_diff.oo";
import "dir_watcher.oo";

pub fn blackbox_mcp_tool_count() -> Int {
    return 2;
}

pub fn blackbox_mcp_tool_caps(name: String) -> Int {
    if name == "blackbox_autopsy" {
        return 1;
    }
    if name == "blackbox_diff" {
        return 5;
    }
    return 0 - 1;
}

pub fn blackbox_mcp_tool_list_json() -> String {
    let mut out: String = "[";
    out = out + "{\"name\":\"blackbox_autopsy\",";
    out = out + "\"description\":\"Parse .blackbox/autopsy.json and output 1-turn root-cause diagnosis\",";
    out = out + "\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Path to autopsy.json\"}},\"required\":[]}},";
    out = out + "{\"name\":\"blackbox_diff\",";
    out = out + "\"description\":\"Invoke compiler stages and display semantic AST diffs\",";
    out = out + "\"inputSchema\":{\"type\":\"object\",\"properties\":{\"file\":{\"type\":\"string\",\"description\":\"Path to .oo file\"}},\"required\":[\"file\"]}}";
    out = out + "]";
    return out;
}

fn mcp_extract_arg(args: String, key: String) -> String {
    let pat: String = "\"" + key + "\"";
    let n: Int = chars_len(args);
    let plen: Int = chars_len(pat);
    let mut i: Int = 0;
    while i < n {
        let end_p: Int = i + plen;
        if end_p <= n {
            if str_slice(args, i, end_p) == pat {
                let mut j: Int = end_p;
                while j < n {
                    if char_at(args, j) == ":" {
                        let mut k: Int = j + 1;
                        while k < n {
                            let c: String = char_at(args, k);
                            if c == "\"" {
                                let mut m: Int = k + 1;
                                while m < n {
                                    if char_at(args, m) == "\"" {
                                        return str_slice(args, k + 1, m);
                                    }
                                    m = m + 1;
                                }
                                return "";
                            }
                            if c != " " { if c != "\t" { break; } }
                            k = k + 1;
                        }
                    }
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
    return "";
}

pub fn blackbox_mcp_escape(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\\" { out = out + "\\\\"; }
        else if c == "\"" { out = out + "\\\""; }
        else if c == "\n" { out = out + "\\n"; }
        else if c == "\r" { out = out + "\\r"; }
        else if c == "\t" { out = out + "\\t"; }
        else { out = out + c; }
        i = i + 1;
    }
    return out;
}

pub fn blackbox_mcp_wrap_text(text: String) -> String {
    let esc: String = blackbox_mcp_escape(text);
    return "{\"content\":[{\"type\":\"text\",\"text\":\"" + esc + "\"}]}";
}

pub fn blackbox_mcp_dispatch(name: String, args: String, fs: &FsReadCap, p: &ProcessCap) -> String {
    if name == "blackbox_autopsy" {
        let mut pth: String = mcp_extract_arg(args, "path");
        if chars_len(pth) == 0 {
            pth = dir_watcher_autopsy_file();
        }
        let rd: Result[String, String] = dir_watcher_read_autopsy(fs, pth);
        if rd.is_err() {
            return "{\"isError\":true,\"content\":[{\"type\":\"text\",\"text\":\"Failed to read autopsy file: " + rd.unwrap_err() + "\"}]}";
        }
        let rep: Result[String, String] = autopsy_format_from_json(rd.unwrap());
        if rep.is_err() {
            return "{\"isError\":true,\"content\":[{\"type\":\"text\",\"text\":\"Failed to parse autopsy: " + rep.unwrap_err() + "\"}]}";
        }
        return blackbox_mcp_wrap_text(rep.unwrap());
    }

    if name == "blackbox_diff" {
        let fl: String = mcp_extract_arg(args, "file");
        if chars_len(fl) == 0 {
            return "{\"isError\":true,\"content\":[{\"type\":\"text\",\"text\":\"Missing required argument 'file'\"}]}";
        }
        let dr: Result[String, String] = ast_diff_inspect_file(p, "", fl);
        if dr.is_err() {
            return "{\"isError\":true,\"content\":[{\"type\":\"text\",\"text\":\"AST diff failed: " + dr.unwrap_err() + "\"}]}";
        }
        return blackbox_mcp_wrap_text(dr.unwrap());
    }

    return "{\"isError\":true,\"content\":[{\"type\":\"text\",\"text\":\"Unknown tool: " + name + "\"}]}";
}

pub fn mcp_bridge_tool_count() -> Int {
    return blackbox_mcp_tool_count();
}

pub fn mcp_bridge_tool_caps(name: String) -> Int {
    return blackbox_mcp_tool_caps(name);
}
