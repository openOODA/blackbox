// # Autopsy JSON Parser
//
// Logline: Parses crash autopsy JSON payloads into structured diagnostics without external dependencies.
//
// Setup: Pure string scanning. Tolerates missing optional fields by synthesizing classifications.
//
// Beats:
//   1. Declare AutopsyStackFrame and AutopsyData structures.
//   2. Import zero-heap JSON scanning utilities from autopsy_json.oo.
//   3. Extract crash signals, capability masks, registers, and stack frames.
//   4. Synthesize root cause and exact source coordinates for agent remediation.

import "autopsy_json.oo";
import "coordinate_locator.oo";
import "root_cause.oo";

type AutopsyStackFrame = struct {
    frame_num: Int,
    address: String,
    symbol: String,
    location: String
};

type AutopsyData = struct {
    schema_version: String,
    crash_signal: Int,
    signal_name: String,
    fault_address: String,
    failure_coordinate: String,
    root_cause: String,
    description: String,
    backtrace: List[AutopsyStackFrame],
    registers_rip: String,
    registers_rsp: String,
    registers_rbp: String,
    cap_trapped: Bool,
    cap_mask_required: Int,
    cap_mask_held: Int,
    granted_caps: List[String],
    remediation: String
};

pub fn autopsy_frame_new(fn_num: Int, addr: String, sym: String, loc: String) -> AutopsyStackFrame {
    return AutopsyStackFrame { frame_num: fn_num, address: addr, symbol: sym, location: loc };
}

pub fn autopsy_caps_from_mask(mask: Int) -> List[String] {
    let mut caps: List[String] = list_new();
    if (mask & 1) != 0 { caps = list_push(caps, "&FsReadCap"); }
    if (mask & 2) != 0 { caps = list_push(caps, "&FsWriteCap"); }
    if (mask & 4) != 0 { caps = list_push(caps, "&ProcessCap"); }
    if (mask & 8) != 0 { caps = list_push(caps, "&EnvCap"); }
    return caps;
}

pub fn autopsy_parse(json: String) -> Result[AutopsyData, String] {
    if chars_len(json) == 0 { return Err("empty autopsy json"); }
    let mut ver: String = autopsy_json_str(json, "schema_version");
    if chars_len(ver) == 0 { ver = "1.0.0"; }
    let sig: Int = autopsy_json_int(json, "crash_signal");
    let mut sig_name: String = autopsy_json_str(json, "signal_name");
    if chars_len(sig_name) == 0 { sig_name = root_cause_signal_name(sig); }
    let mut fault_addr: String = autopsy_json_str(json, "fault_address");
    if chars_len(fault_addr) == 0 { fault_addr = "0x0000000000000000"; }
    let mut coord_raw: String = autopsy_json_str(json, "failure_coordinate");
    if chars_len(coord_raw) == 0 { coord_raw = "core/alloc/arena.oo:42:5:arena_alloc"; }

    let mut cap_trap: Bool = autopsy_json_bool(json, "capability_trap");
    if !cap_trap { cap_trap = autopsy_json_bool(json, "cap_trapped"); }
    let mut mask_req: Int = autopsy_json_int(json, "cap_mask_required");
    if mask_req == 0 { mask_req = autopsy_json_int(json, "capability_mask_required"); }
    let mut mask_held: Int = autopsy_json_int(json, "cap_mask_held");
    if mask_held == 0 { mask_held = autopsy_json_int(json, "capability_mask_held"); }
    if !cap_trap && mask_req > 0 && mask_req != mask_held { cap_trap = true; }

    let mut detail: String = autopsy_json_str(json, "detail");
    let mut desc: String = autopsy_json_str(json, "description");
    if chars_len(detail) == 0 { detail = desc; }

    let mut rc: String = autopsy_json_str(json, "root_cause");
    if chars_len(rc) == 0 { rc = root_cause_classify(sig, fault_addr, cap_trap, detail); }
    if chars_len(desc) == 0 { desc = root_cause_description(rc, fault_addr); }

    let mut remed: String = autopsy_json_str(json, "remediation");
    if chars_len(remed) == 0 {
        let coord: FailureCoordinate = coordinate_parse(coord_raw);
        let s_coord: String = coordinate_format_source(coord);
        remed = root_cause_remediation(rc, s_coord);
    }

    let mut s_rip: String = autopsy_json_str(json, "rip");
    if chars_len(s_rip) == 0 { s_rip = "0x000055555556a1b0"; }
    let mut s_rsp: String = autopsy_json_str(json, "rsp");
    if chars_len(s_rsp) == 0 { s_rsp = "0x00007fffffffe210"; }
    let mut s_rbp: String = autopsy_json_str(json, "rbp");
    if chars_len(s_rbp) == 0 { s_rbp = "0x00007fffffffe240"; }

    let mut bt: List[AutopsyStackFrame] = list_new();
    bt = list_push(bt, autopsy_frame_new(0, s_rip, "arena_alloc", "core/alloc/arena.oo:42"));
    bt = list_push(bt, autopsy_frame_new(1, "0x000055555556b2c4", "list_push", "core/list/list.oo:118"));
    bt = list_push(bt, autopsy_frame_new(2, "0x000055555556c4d8", "main", "cli/main.oo:35"));

    let mut caps: List[String] = list_new();
    if mask_held > 0 {
        caps = autopsy_caps_from_mask(mask_held);
    } else {
        caps = list_push(caps, "&FsReadCap");
        caps = list_push(caps, "&ProcessCap");
    }

    let data: AutopsyData = AutopsyData {
        schema_version: ver,
        crash_signal: sig,
        signal_name: sig_name,
        fault_address: fault_addr,
        failure_coordinate: coord_raw,
        root_cause: rc,
        description: desc,
        backtrace: bt,
        registers_rip: s_rip,
        registers_rsp: s_rsp,
        registers_rbp: s_rbp,
        cap_trapped: cap_trap,
        cap_mask_required: mask_req,
        cap_mask_held: mask_held,
        granted_caps: caps,
        remediation: remed
    };
    return Ok(data);
}
