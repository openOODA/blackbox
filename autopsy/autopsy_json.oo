// # Autopsy JSON Lexer & Utilities
//
// Logline: Zero-heap string and JSON scanning primitives for crash dump parsing.
//
// Setup: Pure string scanning without dynamic allocations. Fail-closed on missing keys.
//
// Beats:
//   1. Character classification predicates (whitespace, compounds, delimiters, digits).
//   2. Whitespace skipper and token boundary locators.
//   3. Key locator and compound-aware value slice extractor.
//   4. Primitive typed extractors for strings, integers, and booleans.

pub fn json_is_ws(c: String) -> Bool {
    return c == " " || c == "\t" || c == "\n" || c == "\r";
}

pub fn json_is_compound(c: String) -> Bool {
    return c == "{" || c == "[";
}

pub fn json_is_delim(c: String) -> Bool {
    return c == "," || c == "}" || c == "]" || json_is_ws(c);
}

pub fn json_is_digit(c: String) -> Bool {
    return c == "0" || c == "1" || c == "2" || c == "3" || c == "4" ||
           c == "5" || c == "6" || c == "7" || c == "8" || c == "9";
}

pub fn json_skip_ws(s: String, i: Int) -> Int {
    let n: Int = chars_len(s);
    let mut j: Int = i;
    while j < n {
        if !json_is_ws(char_at(s, j)) { return j; }
        j = j + 1;
    }
    return j;
}

pub fn json_find_key(json: String, key: String) -> Int {
    let pat: String = "\"" + key + "\"";
    let n: Int = chars_len(json);
    let plen: Int = chars_len(pat);
    let mut i: Int = 0;
    let mut in_str: Bool = false;
    let mut esc: Bool = false;
    while i < n {
        let c: String = char_at(json, i);
        if in_str {
            if esc { esc = false; } else if c == "\\" { esc = true; } else if c == "\"" { in_str = false; }
            i = i + 1;
            continue;
        }
        if c == "\"" {
            let end_p: Int = i + plen;
            if end_p <= n {
                if str_slice(json, i, end_p) == pat {
                    let mut j: Int = json_skip_ws(json, end_p);
                    if j < n {
                        if char_at(json, j) == ":" { return json_skip_ws(json, j + 1); }
                    }
                }
            }
            in_str = true;
            i = i + 1;
            continue;
        }
        i = i + 1;
    }
    return 0 - 1;
}

pub fn json_take_val(json: String, start: Int) -> String {
    if start < 0 { return ""; }
    let n: Int = chars_len(json);
    if start >= n { return ""; }
    let c0: String = char_at(json, start);
    if c0 == "\"" {
        let mut i: Int = start + 1;
        let mut esc: Bool = false;
        while i < n {
            let c: String = char_at(json, i);
            if esc { esc = false; } else if c == "\\" { esc = true; } else if c == "\"" {
                let end_idx: Int = i + 1;
                return str_slice(json, start, end_idx);
            }
            i = i + 1;
        }
        return "";
    }
    if json_is_compound(c0) {
        let close: String = if c0 == "{" { "}" } else { "]" };
        let mut depth: Int = 0;
        let mut in_str: Bool = false;
        let mut esc: Bool = false;
        let mut i: Int = start;
        while i < n {
            let c: String = char_at(json, i);
            if in_str {
                if esc { esc = false; } else if c == "\\" { esc = true; } else if c == "\"" { in_str = false; }
            } else if c == "\"" { in_str = true; }
            else if c == c0 { depth = depth + 1; }
            else if c == close {
                depth = depth - 1;
                if depth == 0 {
                    let end_idx: Int = i + 1;
                    return str_slice(json, start, end_idx);
                }
            }
            i = i + 1;
        }
        return "";
    }
    let mut i: Int = start;
    while i < n {
        let c: String = char_at(json, i);
        if json_is_delim(c) { break; }
        i = i + 1;
    }
    return str_slice(json, start, i);
}

pub fn autopsy_json_str(json: String, key: String) -> String {
    let pos: Int = json_find_key(json, key);
    let raw: String = json_take_val(json, pos);
    let n: Int = chars_len(raw);
    if n >= 2 {
        if char_at(raw, 0) == "\"" {
            let last_idx: Int = n - 1;
            if char_at(raw, last_idx) == "\"" { return str_slice(raw, 1, last_idx); }
        }
    }
    return raw;
}

pub fn autopsy_json_int(json: String, key: String) -> Int {
    let raw: String = autopsy_json_str(json, key);
    let n: Int = chars_len(raw);
    if n == 0 { return 0; }
    let mut neg: Bool = false;
    let mut i: Int = 0;
    if char_at(raw, 0) == "-" {
        neg = true;
        i = 1;
    }
    let mut val: Int = 0;
    while i < n {
        let c: String = char_at(raw, i);
        if json_is_digit(c) {
            let d: Int = if c == "0" { 0 } else if c == "1" { 1 } else if c == "2" { 2 }
                         else if c == "3" { 3 } else if c == "4" { 4 } else if c == "5" { 5 }
                         else if c == "6" { 6 } else if c == "7" { 7 } else if c == "8" { 8 } else { 9 };
            val = val * 10 + d;
        } else { break; }
        i = i + 1;
    }
    if neg { return 0 - val; }
    return val;
}

pub fn autopsy_json_bool(json: String, key: String) -> Bool {
    let raw: String = autopsy_json_str(json, key);
    return raw == "true" || raw == "1";
}
