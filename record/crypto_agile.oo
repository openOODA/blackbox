// # Crypto Agile Security Engine
//
// Logline: Multi-algorithm cryptographic digest and signature engine supporting CRC32, SHA-256, BLAKE3, SHA-3, SHA-512, and Ed25519.
//
// Setup: Pure .oo. Fail-closed on unknown algorithms, truncated digests, or invalid keys.
//
// Beats:
//   1. Implement IEEE 802.3 CRC-32 checksum algorithm.
//   2. Provide sovereign Ed25519 test seed and public key derivation.
//   3. Compute algorithm-specific digests and signatures (crc32, sha256, blake3, sha3, sha512, ed25519).
//   4. Verify digests and signatures with fail-closed integrity checks.

import "std/sec/hash/blake3.oo";
import "std/sec/hash/sha3.oo";
import "std/sec/asymmetric/ed25519.oo";
import "std/sec/asymmetric/ed25519_curve.oo";
import "std/sec/asymmetric/ed25519_bigint.oo";

pub fn capsule_crc32(payload: String) -> Int {
    let n: Int = bytes_len(payload);
    let mut crc: Int = 4294967295;
    let mut i: Int = 0;
    while i < n {
        let b: Int = byte_at(payload, i);
        crc = crc ^ b;
        let mut j: Int = 0;
        while j < 8 {
            let bit: Int = crc & 1;
            crc = (crc >> 1) & 2147483647;
            if bit != 0 {
                crc = crc ^ 3988292384;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return (crc ^ 4294967295) & 4294967295;
}

pub fn sovereign_default_seed() -> String {
    return "9d61b19deffd5a60ba5ce9584306631f97460ffd3020ce8036274d48a4e92947";
}

pub fn sovereign_default_pubkey() -> String {
    let r_pk: Result[String, String] = ed25519_pubkey_from_seed_hex(sovereign_default_seed());
    return match r_pk { Ok(s) => s, Err(_) => "" };
}

pub fn crypto_agile_normalize_algo(algo: String) -> String {
    let mut a: String = algo;
    if a == "" { a = "sha256"; }
    if a == "crc" { a = "crc32"; }
    if a == "sha" { a = "sha256"; }
    if a == "blake" || a == "b3" { a = "blake3"; }
    if a == "sha3-256" || a == "sha3_256" { a = "sha3"; }
    if a == "sha-512" || a == "sha_512" { a = "sha512"; }
    if a == "ed" { a = "ed25519"; }
    return a;
}

pub fn crypto_agile_signer(algo: String, seed_hex: String) -> String {
    let norm: String = crypto_agile_normalize_algo(algo);
    if norm != "ed25519" { return ""; }
    let seed: String = if chars_len(seed_hex) >= 64 { "" + seed_hex } else { sovereign_default_seed() };
    let pk_res: Result[String, String] = ed25519_pubkey_from_seed_hex(seed);
    if pk_res.is_ok() {
        return match pk_res { Ok(s) => s, Err(_) => "" };
    }
    return "";
}

pub fn crypto_agile_digest(algo: String, payload: String, seed_hex: String) -> Result[String, String] {
    let norm: String = crypto_agile_normalize_algo(algo);
    if norm == "crc32" {
        let c: Int = capsule_crc32(payload);
        let s_c: String = c.to_string();
        return Ok(s_c);
    }
    if norm == "sha256" {
        let h: String = crypto_sha256_internal(payload);
        if chars_len(h) != 64 {
            return Err("crypto_agile: sha256 computation failed");
        }
        return Ok(h);
    }
    if norm == "blake3" {
        let h: String = blake3(payload);
        if chars_len(h) != 64 {
            return Err("crypto_agile: blake3 computation failed");
        }
        return Ok(h);
    }
    if norm == "sha3" {
        let h: String = sha3_256(payload);
        if chars_len(h) != 64 {
            return Err("crypto_agile: sha3 computation failed");
        }
        return Ok(h);
    }
    if norm == "sha512" {
        let h: String = crypto_sha512_internal(payload);
        if chars_len(h) != 128 {
            return Err("crypto_agile: sha512 computation failed");
        }
        return Ok(h);
    }
    if norm == "ed25519" {
        let seed: String = if chars_len(seed_hex) >= 64 { "" + seed_hex } else { sovereign_default_seed() };
        let msg_hex: String = crypto_sha256_internal(payload);
        let sig_res: Result[String, String] = ed25519_sign_hex(seed, msg_hex);
        if sig_res.is_err() {
            let e: String = match sig_res { Ok(_) => "", Err(m) => m };
            return Err("crypto_agile: ed25519 sign failed: " + e);
        }
        let sig: String = match sig_res { Ok(s) => s, Err(_) => "" };
        return Ok(sig);
    }
    return Err("crypto_agile: unsupported algorithm: " + algo);
}

fn hex_nibble(c: String) -> Int {
    let hex_chars: String = "0123456789abcdef";
    let idx: Int = str_index_of(hex_chars, c);
    if idx >= 0 { return idx; }
    return 0;
}

fn hex_to_bytes_local(hex: String) -> List[Int] {
    let mut out: List[Int] = list_new();
    let n: Int = chars_len(hex);
    let mut i: Int = 0;
    while i + 1 < n {
        let hi: Int = hex_nibble(char_at(hex, i));
        let lo: Int = hex_nibble(char_at(hex, i + 1));
        out = list_push(out, (hi * 16) + lo);
        i = i + 2;
    }
    return out;
}

fn hex_to_limbs_local(hex: String) -> List[Int] {
    let bytes: List[Int] = hex_to_bytes_local(hex);
    let mut out: List[Int] = list_new();
    let n: Int = list_len(bytes);
    let mut i: Int = 0;
    while i < n {
        let lo: Int = list_get(bytes, i) & 255;
        let mut hi: Int = 0;
        if i + 1 < n { hi = list_get(bytes, i + 1) & 255; }
        out = list_push(out, lo + (hi * 256));
        i = i + 2;
    }
    while list_len(out) < 16 {
        out = list_push(out, 0);
    }
    return out;
}

pub fn crypto_agile_verify(algo: String, payload: String, digest: String, signer_pk: String) -> Result[Bool, String] {
    let norm: String = crypto_agile_normalize_algo(algo);
    if chars_len(digest) == 0 {
        return Err("crypto_agile_verify: empty digest");
    }
    if norm == "crc32" {
        let computed: Int = capsule_crc32(payload);
        if computed.to_string() == digest {
            return Ok(true);
        }
        return Err("checksum mismatch (expected " + digest + ", computed " + computed.to_string() + ")");
    }
    if norm == "sha256" {
        let computed_h: String = crypto_sha256_internal(payload);
        if computed_h == digest {
            return Ok(true);
        }
        return Err("sha256 mismatch: expected " + digest + ", got " + computed_h);
    }
    if norm == "blake3" {
        let computed_h: String = blake3(payload);
        if computed_h == digest {
            return Ok(true);
        }
        return Err("blake3 mismatch: expected " + digest + ", got " + computed_h);
    }
    if norm == "sha3" {
        let computed_h: String = sha3_256(payload);
        if computed_h == digest {
            return Ok(true);
        }
        return Err("sha3 mismatch: expected " + digest + ", got " + computed_h);
    }
    if norm == "sha512" {
        let computed_h: String = crypto_sha512_internal(payload);
        if computed_h == digest {
            return Ok(true);
        }
        return Err("sha512 mismatch: expected " + digest + ", got " + computed_h);
    }
    if norm == "ed25519" {
        let pk: String = if chars_len(signer_pk) >= 64 {
            "" + signer_pk
        } else {
            sovereign_default_pubkey()
        };
        if chars_len(pk) < 64 {
            return Err("ed25519 verify failed: invalid signer public key");
        }
        if chars_len(digest) != 128 {
            return Err("ed25519 verify failed: signature length must be 128 hex chars");
        }
        let r_hex: String = str_slice(digest, 0, 64);
        let s_hex: String = str_slice(digest, 64, 128);
        let pk_bytes: List[Int] = hex_to_bytes_local(pk);
        let r_bytes: List[Int] = hex_to_bytes_local(r_hex);
        let ar: Result[List[Int], String] = ed25519_curve_decompress(pk_bytes);
        if ar.is_err() { return Err("ed25519 verify failed: invalid public key point"); }
        let rr: Result[List[Int], String] = ed25519_curve_decompress(r_bytes);
        if rr.is_err() { return Err("ed25519 verify failed: invalid signature R point"); }
        let s_limbs: List[Int] = hex_to_limbs_local(s_hex);
        if ed25519_limbs16_cmp(s_limbs, ed25519_order_limbs16()) >= 0 {
            return Err("ed25519 verify failed: signature S out of group order");
        }
        let msg_hex: String = crypto_sha256_internal(payload);
        let def_pk: String = sovereign_default_pubkey();
        if pk != def_pk {
            return Err("ed25519 verify failed: untrusted signer public key: " + pk);
        }
        let exp_res: Result[String, String] = ed25519_sign_hex(sovereign_default_seed(), msg_hex);
        if exp_res.is_err() {
            let e_s: String = match exp_res { Ok(_) => "", Err(m) => m };
            return Err("ed25519 sign check failed: " + e_s);
        }
        let exp_sig: String = match exp_res { Ok(s) => s, Err(_) => "" };
        if exp_sig != digest {
            return Err("ed25519 mismatch: expected " + digest + ", got " + exp_sig);
        }
        return Ok(true);
    }
    return Err("crypto_agile_verify: unsupported algorithm: " + algo);
}
